# Postgres (async SQLAlchemy driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ridesync

# Ride lifecycle
RIDE_TTL_HOURS=12

# CORS: comma-separated browser origins; empty = disabled (the app does not need it)
CORS_ORIGINS=

# Data retention: ended rides are deleted after N days
RETENTION_DAYS=7

# Public URL of this backend (QR join links -> https://<this>/join/CODE). Empty = ridesync.app
PUBLIC_BASE_URL=
# Where the join page sends people without the app
APP_DOWNLOAD_URL=https://github.com/JyotiPrakash769/ridesync/releases/latest
# SHA-256 of the APK signing cert(s), comma-separated; enables /.well-known/assetlinks.json
ANDROID_CERT_SHA256=

# Optional error reporting (sentry.io); empty = off
SENTRY_DSN=

# Google Maps Platform server key (Routes API + Places API (New)); stays on the server.
# Empty = OSM place search + straight-line "approximate" routes.
GOOGLE_MAPS_SERVER_KEY=
